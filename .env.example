# Discord Bot
DISCORD_BOT_TOKEN=

# AI provider key (optional). Seeded into the bot's AI settings on first
# run; after that the dashboard's Settings -> AI Provider page owns it.
GEMINI_API_KEY=

# Lavalink. Seeded into the music plugin's settings on first run; after that
# the plugin's own copy is what the Lavalink container is started with.
LAVALINK_PASSWORD=

# YouTube OAuth (optional — leave empty, fill via web panel after first run).
# Also seeded into the music plugin's settings on first run.
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Discord OAuth2 Client Secret (optional — leave empty, fill via web panel).
# From your app's OAuth2 page in the Discord Developer Portal; the Client ID is
# detected automatically from the bot token. Setting this turns on dashboard
# login, once a home server is set.
DISCORD_CLIENT_SECRET=

# SESSION_SECRET_KEY is generated automatically on first run — no need to set it.