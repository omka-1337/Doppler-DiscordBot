# Version control
.git
.gitignore

# Local dev environment
.venv
.vscode

# Runtime data (bind-mounted at runtime, never needed in the image itself).
# plugins/ and config/ are written by the broker as root, so leaving them in
# the build context also breaks the build for the user who owns the project.
savedata
plugins
config
*.db
latest.log

# Secrets (never baked into an image layer)
.env

# Python cache
__pycache__
*.pyc

